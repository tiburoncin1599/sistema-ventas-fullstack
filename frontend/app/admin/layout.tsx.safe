'use client';

import { useState, useEffect } from 'react';
import Link from 'next/link';
import { api } from '@/lib/api';
import DarkModeToggle from '@/components/DarkModeToggle';
import { motion } from 'framer-motion';
import { Menu, X, Search } from 'lucide-react';

interface SeccionMenu {
  href: string;
  titulo: string;
  desc: string;
  roles: string[];
}

function useAuth() {
  const [usuario, setUsuario] = useState<{ nombre: string; rol: string } | null>(null);

  useEffect(() => {
    const checkUser = () => {
      if (typeof window !== 'undefined') {
        try {
          const u = localStorage.getItem('usuario');
          setUsuario(u ? JSON.parse(u) : null);
        } catch { setUsuario(null); }
      }
    };
    checkUser();
    const onStorage = () => checkUser();
    window.addEventListener('storage', onStorage);
    return () => window.removeEventListener('storage', onStorage);
  }, []);

  return usuario;
}

function obtenerClaseSidebar(esActivo: boolean, sidebarCollapsed: boolean): string {
  if (esActivo) {
    if (sidebarCollapsed) {
      return 'bg-prolimal-blue-50 text-prolimal-blue-600 border-prolimal-border pr-8';
    }
    return 'bg-prolimal-blue-50 text-prolimal-blue-600 border-prolimal-border border-r-2';
  }
  if (sidebarCollapsed) {
    return 'text-prolimal-gray-300 hover:text-prolimal-gray-100 hover:bg-prolimal-gray-900/50';
  }
  return 'text-prolimal-gray-300 hover:text-prolimal-gray-100 hover:bg-prolimal-gray-900/50';
}

export default function AdminLayout({
  children,
  title = 'Panel de Administración',
}: { children: React.ReactNode; title?: string }) {
  const usuario = useAuth();
  const [menuOpen, setMenuOpen] = useState(false);
  const [sidebarCollapsed, setSidebarCollapsed] = useState(false);

  const seccionesAdmin: SeccionMenu[] = [
    { href: '/admin/productos', titulo: 'Productos', desc: 'Crear, editar y desactivar productos', roles: ['admin', 'inventario'] },
    { href: '/admin/inventario', titulo: 'Inventario', desc: 'Controlar stock y cantidades mínimas', roles: ['admin', 'inventario'] },
    { href: '/admin/pedidos', titulo: 'Pedidos', desc: 'Administrar pedidos de clientes', roles: ['admin', 'inventario'] },
    { href: '/admin/clientes', titulo: 'Clientes', desc: 'Registrar y administrar clientes', roles: ['admin'] },
    { href: '/admin/usuarios', titulo: 'Usuarios', desc: 'Gestionar empleados y roles', roles: ['admin'] },
    { href: '/admin/deudas', titulo: 'Deudas', desc: 'Deudas del personal y facturas', roles: ['admin', 'inventario', 'ventas'] },
    { href: '/admin/reportes', titulo: 'Reportes', desc: 'Ventas, ganancias e inventario', roles: ['admin'] },
    { href: '/admin/personal', titulo: 'Rendimiento Personal', desc: 'Gráficas semanales y mensuales', roles: ['admin'] },
    { href: '/admin/ubicaciones', titulo: 'Ubicaciones', desc: 'Gestión de ubicaciones', roles: ['admin'] },
    { href: '/ventas', titulo: 'Mi Portal de Ventas', desc: 'Registrar clientes y gestionar pedidos', roles: ['ventas'] },
    { href: '/admin/ventas', titulo: 'Ventas', desc: 'Historial de ventas del personal', roles: ['admin', 'inventario', 'ventas'] },
  ];

  const filtrarSecciones = seccionesAdmin.filter(s =>
    s.roles.includes(usuario?.rol ?? '') || s.roles.includes('all')
  );

  useEffect(() => {
    const actualizarAncho = () => {
      setSidebarCollapsed(window.innerWidth < 768);
    };
    actualizarAncho();
    window.addEventListener('resize', actualizarAncho);
    return () => window.removeEventListener('resize', actualizarAncho);
  }, []);

  const isMobile = typeof window !== 'undefined' && window.innerWidth < 768;

  useEffect(() => {
    const actualizarSidebar = () => {
      setSidebarCollapsed(window.innerWidth < 768);
    };
    actualizarSidebar();
    window.addEventListener('resize', actualizarSidebar);
    return () => window.removeEventListener('resize', actualizarSidebar);
  }, []);

  // Clases CSS fijas para el sidebar - siempre visible en desktop, colapsable en mobile
  const sidebarClass = 'fixed left-0 top-0 bottom-0 w-64 bg-prolimal-sidebar/90 backdrop-blur-xl border-r border-prolimal-border/50 transition-all duration-300 overflow-y-auto z-50';
  const sidebarCollapsedTransform = 'translate-X-full';
  const sidebarExpandedTransform = 'translate-X-0';

  return (
    <html lang="es" className="bg-prolimal-bg">
      <body className="min-h-screen bg-prolimal-bg text-prolimal-dark-800 dark:text-prolimal-light">
        {/* Overlay cuando el menú está abierto -->
        {isMobile && menuOpen && (
          <div className="fixed inset-0 bg-black/40 backdrop-blur-sm z-40" onClick={() => setMenuOpen(false)} aria-hidden="true" />
        )}

        {/* Sidebar -->
        <aside className="sidebarClass left-0 top-0 bottom-0 w-64 {sidebarCollapsed ? 'transform translate-x-full' : 'transform translate-x-0'} opacity-100 transition-transform duration-300">
          <div className="h-16 flex items-center justify-between px-4 sm:px-6">
            <div className="flex items-center gap-3">
              <Link href="/" className="text-prolimal-blue-600 font-bold text-xl tracking-wider">
                <span className="hidden sm:block">PROLIMAC</span>
                <span className="block sm:hidden">P</span>
              </Link>
              <div className="flex items-center gap-2">
                {sidebarCollapsed ? (
                  <X className="w-5 h-5 text-prolimal-gray-400 hover:text-prolimal-gray-600 cursor-pointer" onClick={() => setMenuOpen(false)} />
                ) : (
                  <Search className="w-5 h-5 text-prolimal-gray-400 hover:text-prolimal-gray-600 cursor-pointer" placeholder="Buscar" />
                )}
              </div>
            </div>
            <DarkModeToggle />
          </div>

          <nav className="space-y-1 px-4">
            <div className="pt-2 border-y border-prolimal-border/50">
              {filtrarSecciones.map((seccion) => {
                const esRolValido = seccion.roles.includes(usuario?.rol ?? '');
                if (!esRolValido) return null;

                const esActivo = seccion.href === window.location.pathname;
                const activeClass = obtenerClaseSidebar(esActivo, sidebarCollapsed);

                return (
                  <div
                    key={seccion.href}
                    className={`flex items-center ${activeClass}`}
                    onClick={() => setMenuOpen(false)}
                  >
                    <span className="w-2 h-2 rounded-full bg-prolimal-blue-500 ${esActivo ? 'opacity-100' : 'opacity-0'} mr-3"/>
                    <Link href={seccion.href} className="flex items-center gap-3 whitespace-nowrap">
                      {seccion.titulo}
                      {esActivo && (
                        <svg className="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path className="prolimal-blue-600" strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 10l7-7 7 7"/>
                        </svg>
                      )}
                    </Link>
                  </div>
                );
              })}
            </div>
          </nav>

          {/* Footer del sidebar */}
          <div className="pt-4 pb-6 border-t border-prolimal-border/50">
            <div className="flex items-center gap-3 px-2">
              <span className="text-xs text-prolimal-gray-400">PROLIMAC SRL</span>
              <span className="text-prolimal-gray-500 text-xs">{usuario?.rol || ''}</span>
            </div>
          </div>
        </aside>

        {/* Contenido principal -->
        <main className="ml-64 min-h-screen px-6 sm:px-8 lg:px-12 py-8 transition-all duration-300">
          <header className="flex items-center justify-between mb-8">
            <div className="flex items-center gap-3">
              <button
                className="sm:hidden rounded-lg bg-prolimal-gray-100 p-2 hover:bg-prolimal-gray-200 transition-colors"
                onClick={() => setMenuOpen(!menuOpen)}
                aria-label="Abrir menú"
              >
                {menuOpen ? <X className="w-5 h-5" /> : <Menu className="w-5 h-5" />}
              </button>
              <h1 className="text-2xl font-bold text-prolimal-dark-800">PROLIMAC SRL</h1>
            </div>

            <div className="flex items-center gap-4">
              <DarkModeToggle />
              <span className="text-prolimal-gray-400 text-sm">Bienvenido, {usuario?.nombre || ''}</span>
            </div>
          </header>

          {/* Contenido con animación Framer Motion -->
          <section className="prose lg:prose-xl max-w-7xl mx-auto">
            {children}
          </section>
        </main>
      </body>
    </html>
  );
}