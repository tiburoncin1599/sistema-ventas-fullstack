# Docker Compose - Variables de entorno para desarrollo local
# Copia este archivo a .env y ajusta los valores según necesidad

# PostgreSQL
POSTGRES_USER=ventas_user
POSTGRES_PASSWORD=ventas_pass
POSTGRES_DB=sistema_ventas
POSTGRES_PORT=5433

# Backend
BACKEND_PORT=3001
JWT_SECRET=dev_jwt_secret_change_me_very_long_random_string_at_least_32_characters
FRONTEND_URL=http://localhost:3000
ADMIN_EMAILS=

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://backend:3001

# Database SSL
# false = local/Docker, true = producción con Neon/Render
DB_SSL=false
DATABASE_SSL=false
