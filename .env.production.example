# Plantilla para .env.production (Sprint 5)
# Copiar: cp .env.production.example .env.production
# Sustituir TODOS los valores marcados como CHANGE_ME antes de desplegar.

# PostgreSQL
POSTGRES_USER=ventas_user
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD_SEGURO
POSTGRES_DB=sistema_ventas
POSTGRES_PORT=5433

# Backend NestJS
NODE_ENV=production
# PORT se define por servicio en docker-compose.yml (backend 3001 / frontend 3000).
# Debe usar el host interno `db` (no localhost) y las mismas credenciales anteriores.
DATABASE_URL=postgresql://ventas_user:CHANGE_ME_PASSWORD_SEGURO@db:5432/sistema_ventas
DB_SSL=false
JWT_SECRET=CHANGE_ME_MINIMO_32_CARACTERES_ALEATORIOS
FRONTEND_URL=https://tu-dominio.example
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://tu-dominio.example/auth/google/callback
TZ=America/La_Paz
BACKEND_PORT=3001

# Frontend Next.js
FRONTEND_PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://backend:3001
NEXT_TELEMETRY_DISABLED=1

# Backup (scripts/backup-db.sh)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
DB_CONTAINER=sistema_ventas_db
